{
  "dashboard": {
    "id": null,
    "uid": "tea-service",
    "title": "Tea Service",
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "5s",
    "panels": [
      {
        "type": "timeseries",
        "title": "JVM Used Memory",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "jvm_memory_used_bytes",
            "refId": "A"
          }
        ],
        "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }
      },
      {
        "type": "timeseries",
        "title": "HTTP Requests",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "http_server_requests_seconds_count",
            "refId": "B"
          }
        ],
        "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }
      },
      {
        "type": "stat",
        "title": "Application Uptime",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "process_uptime_seconds",
            "refId": "C"
          }
        ],
        "gridPos": { "x": 0, "y": 8, "w": 6, "h": 4 }
      }
    ]
  },
  "overwrite": true
}
